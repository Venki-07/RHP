#include<iostream>
#include<algorithm>
using namespace std;
int main(){
    int a,b;
    cin>>a>>b;
    int arr1[a];
    int arr2[b];
    for(int i = 0;i<a;i++){
        cin>>arr1[i];
    }
    for(int j = 0;j<b;j++){
        cin>>arr2[j];
    }
     sort(arr1, arr1+a);
    sort(arr2, arr2+b);
     for(int i = 0;i<a;i++){
        cout<<arr1[i]<<" ";
    }
    cout<<endl;
    for(int j = 0;j<b;j++){
        cout<<arr2[j]<<" ";
    }
   
    int count = 0;
    for(int i = a;i>=0;i--){
        for(int j = b;j>=0;j--){
            if(arr2[j]<2*arr1[i]){
                count++;
                j--;
                i--;
            }else{
                j--;
            }
        }
    }
    cout<<endl;
    cout<<"Count: "<<count;
}
