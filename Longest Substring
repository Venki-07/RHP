#include <iostream>
using namespace std;

int main() {
    string word1, word2;
    cin >> word1 >> word2;

    int row = word1.size();
    int col = word2.size();
    
    int matrix[101][101] ;
    int maxLen = 0; 

    for (int i = 1; i <= row; i++) {
        for (int j = 1; j <= col; j++) {
            if (word1[i - 1] == word2[j - 1]) {
                matrix[i][j] = matrix[i - 1][j - 1] + 1;
                if (matrix[i][j] > maxLen) {
                    maxLen = matrix[i][j];
                }
            } else {
                matrix[i][j] = 0;
            }
        }
    }

    for (int i = 0; i <= row; i++) {
        for (int j = 0; j <= col; j++) {
            cout << matrix[i][j] << " ";
        }
        cout << endl;
    }

    cout << "Longest Common Substring Length = " << maxLen << endl;
    return 0;
}
