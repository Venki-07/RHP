#include<iostream>
#include <climits>
using namespace std;

int main(){
    int a,b;
    cout<<"Enter the r and c : ";
    cin>>a>>b;
    int arr[50][50]; // adjust size if needed
    int rel[50][50];

    // Input matrix
    for(int i = 0;i<a;i++){
        for(int j = 0;j<b;j++){
            cin>>arr[i][j];
        }
    }
    
    // Base case: first row
    for(int j = 0;j<b;j++){
        rel[0][j] = arr[0][j];
    }
    
    // Fill DP table row by row
    for(int i = 1;i<a;i++){
        int fmax = INT_MIN;
        int smax = INT_MIN;

        // Find first and second largest in previous DP row
        for(int j = 0;j<b;j++){
            if(rel[i-1][j] > fmax){
                smax = fmax;
                fmax = rel[i-1][j];
            }else if(rel[i-1][j] > smax){
                smax = rel[i-1][j];
            }
        }

        // Update current row
        for(int j = 0;j<b;j++){
            if(rel[i-1][j] == fmax){
                rel[i][j] = arr[i][j] + smax;
            }else{
                rel[i][j] = arr[i][j] + fmax;
            }
        }
    }

    // Find maximum in last row
    int result = INT_MIN;
    for(int j = 0;j<b;j++){
        result = max(result, rel[a-1][j]);
    }

    cout<<"Result: "<<result<<endl;
    return 0;
}
