#include<iostream>
#include <climits>
using namespace std;

int main(){
    int a,b;
    cout<<"Enter the row: ";
    cin>>a;
    cout<<"Enter the column: ";
    cin>>b;
    int arr[a][b]; 
    int rel[a][b];
    
    for(int i = 0;i<a;i++){
        for(int j = 0;j<b;j++){
            cin>>arr[i][j];
        }
    }
    
    for(int i = 0;i<a;i++){
        rel[i][0] = arr[i][0];
    }
    

    for(int j = 1;j<b;j++){
        int fmax =  INT_MIN ;
        int smax =  INT_MIN;

        
        for(int i = 0;i<a;i++){
            if(rel[i][j-1] > fmax){
                smax = fmax;
                fmax = rel[i][j-1];
            }else if(rel[i][j-1] > smax){
                smax = rel[i][j-1];
            }
        }

        for(int i = 0;i<a;i++){
            if(rel[i][j-1] == fmax){
                rel[i][j] = arr[i][j] + smax;
            }else{
                rel[i][j] = arr[i][j] + fmax;
            }
        }
    }

    int result = INT_MIN;
    for(int i = 0;i<a;i++){
        result = max(result, rel[b-1][i]);
    }

    cout<<"Result: "<<result<<endl;
    return 0;
}
